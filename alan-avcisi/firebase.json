{
  "hosting": {
    "site": "SITE_ADI",
    "public": ".",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      { "source": "**/*.@(png|jpg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
      { "source": "**/*.@(js|css|json|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
