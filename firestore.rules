rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      // giris yapmis herkes skor tablosunu okuyabilir
      allow read: if request.auth != null;

      // profil olusturma: sayaclar sifirdan baslamali
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','points','wins','draws','losses','goals','matches','last'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 16
        && request.resource.data.points == 0 && request.resource.data.wins == 0
        && request.resource.data.draws == 0 && request.resource.data.losses == 0
        && request.resource.data.goals == 0 && request.resource.data.matches == 0
        && request.resource.data.last == request.time;

      // sadece ad degisikligi
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 16;

      // mac sonucu: sinirli artislar + en az 60 sn ara
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points','wins','draws','losses','goals','matches','last','wk','wp'])
        && request.resource.data.matches == resource.data.matches + 1
        && request.resource.data.points >= resource.data.points
        && request.resource.data.points - resource.data.points <= 5
        && request.resource.data.wins - resource.data.wins <= 1
        && request.resource.data.draws - resource.data.draws <= 1
        && request.resource.data.losses - resource.data.losses <= 1
        && request.resource.data.wins + request.resource.data.draws + request.resource.data.losses
           == resource.data.wins + resource.data.draws + resource.data.losses + 1
        && request.resource.data.goals - resource.data.goals >= 0
        && request.resource.data.goals - resource.data.goals <= 20
        && request.resource.data.last == request.time
        && request.time > resource.data.last + duration.value(60, 's')
        // haftalik puan: hafta numarasi geri gitmez, bir macta en fazla 5 puan
        && request.resource.data.get('wk', 0) >= resource.data.get('wk', 0)
        && request.resource.data.get('wp', 0) >= 0
        && request.resource.data.get('wp', 0) - (request.resource.data.get('wk', 0) == resource.data.get('wk', 0) ? resource.data.get('wp', 0) : 0) <= 5;

      // gorev/basarim odulu: yalnizca puan, tek seferde en fazla 25, en az 10 sn ara
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points','qlast'])
        && request.resource.data.points > resource.data.points
        && request.resource.data.points - resource.data.points <= 25
        && request.resource.data.qlast == request.time
        && request.time > resource.data.get('qlast', request.time - duration.value(1, 'h')) + duration.value(10, 's');
    }

    // haftalik odul belgelerini yalnizca sunucu (Cloud Function) yazar; oyuncu kendininkini okur ve alinca siler
    match /prizes/{pid} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update: if false;
    }

    // arkadas listesi (sadece kendi listen)
    match /users/{uid}/friends/{fid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','t']);
    }

    // arkadas kodu -> kullanici
    match /codes/{code} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','name'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && (resource == null || resource.data.uid == request.auth.uid);
    }

    // "Rakip bul" bekleme listesi
    match /queue/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','name','code','t'])
        && request.resource.data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // arkadas daveti (alici = belge adi)
    match /invites/{to} {
      allow read: if request.auth != null && (request.auth.uid == to || resource.data.from == request.auth.uid);
      allow create, update: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.keys().hasOnly(['from','name','code','t']);
      allow delete: if request.auth != null && (request.auth.uid == to || resource.data.from == request.auth.uid);
    }

    // cevrimici oda sinyali (WebRTC el sikisma bilgisi)
    match /rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.host == request.auth.uid
        && request.resource.data.guest == null
        && request.resource.data.keys().hasOnly(['host','guest','offer','answer','created']);
      allow update: if request.auth != null && (
        resource.data.host == request.auth.uid
        || (resource.data.guest == null
            && request.resource.data.guest == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest','answer'])));
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;
    }
  }
}
