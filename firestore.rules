rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      // giris yapmis herkes skor tablosunu okuyabilir
      allow read: if request.auth != null;

      // profil olusturma: sayaclar sifirdan baslamali
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','points','wins','draws','losses','goals','matches','last'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 16
        && request.resource.data.points == 0 && request.resource.data.wins == 0
        && request.resource.data.draws == 0 && request.resource.data.losses == 0
        && request.resource.data.goals == 0 && request.resource.data.matches == 0
        && request.resource.data.last == request.time;

      // sadece ad degisikligi
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 16;

      // mac sonucu: sinirli artislar + en az 60 sn ara
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points','wins','draws','losses','goals','matches','last','wk','wp'])
        && request.resource.data.matches == resource.data.matches + 1
        && request.resource.data.points >= resource.data.points
        && request.resource.data.points - resource.data.points <= 5
        && request.resource.data.wins - resource.data.wins <= 1
        && request.resource.data.draws - resource.data.draws <= 1
        && request.resource.data.losses - resource.data.losses <= 1
        && request.resource.data.wins + request.resource.data.draws + request.resource.data.losses
           == resource.data.wins + resource.data.draws + resource.data.losses + 1
        && request.resource.data.goals - resource.data.goals >= 0
        && request.resource.data.goals - resource.data.goals <= 20
        && request.resource.data.last == request.time
        && request.time > resource.data.last + duration.value(60, 's')
        // haftalik puan: hafta numarasi geri gitmez, bir macta en fazla 5 puan
        && request.resource.data.get('wk', 0) >= resource.data.get('wk', 0)
        && request.resource.data.get('wp', 0) >= 0
        && request.resource.data.get('wp', 0) - (request.resource.data.get('wk', 0) == resource.data.get('wk', 0) ? resource.data.get('wp', 0) : 0) <= 5;

      // gorev/basarim odulu: yalnizca puan, tek seferde en fazla 25, en az 10 sn ara
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points','qlast'])
        && request.resource.data.points > resource.data.points
        && request.resource.data.points - resource.data.points <= 25
        && request.resource.data.qlast == request.time
        && request.time > resource.data.get('qlast', request.time - duration.value(1, 'h')) + duration.value(10, 's');
    }

    // haftalik odul belgelerini yalnizca sunucu (Cloud Function) yazar; oyuncu kendininkini okur ve alinca siler
    match /prizes/{pid} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update: if false;
    }

    // arkadas listesi (sadece kendi listen)
    match /users/{uid}/friends/{fid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','t']);
    }

    // arkadas kodu -> kullanici
    match /codes/{code} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','name'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && (resource == null || resource.data.uid == request.auth.uid);
    }

    // "Rakip bul" bekleme listesi
    match /queue/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','name','code','t'])
        && request.resource.data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // arkadas daveti (alici = belge adi)
    match /invites/{to} {
      allow read: if request.auth != null && (request.auth.uid == to || resource.data.from == request.auth.uid);
      allow create, update: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.keys().hasOnly(['from','name','code','t']);
      allow delete: if request.auth != null && (request.auth.uid == to || resource.data.from == request.auth.uid);
    }

    // cevrimici oda sinyali (WebRTC el sikisma bilgisi)
    match /rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.host == request.auth.uid
        && request.resource.data.guest == null
        && request.resource.data.keys().hasOnly(['host','guest','offer','answer','created']);
      allow update: if request.auth != null && (
        resource.data.host == request.auth.uid
        || (resource.data.guest == null
            && request.resource.data.guest == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest','answer'])));
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;
    }

    // bulut kaydi: yalnizca Google ile giris yapmis oyuncu, kendi belgesi
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && (request.method == 'delete' || (request.resource.data.keys().hasOnly(['q','tour','jug','t'])
            && request.resource.data.get('q','').size() < 200000
            && request.resource.data.get('tour','').size() < 50000));
    }

    // ===== Amiral Batti (amiral-batti.web.app) =====
    // istemci teshis kayitlari (yalnizca yazilir; okuma sadece sunucudan)
    match /ab_logs/{id} {
      allow read: if false;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid
        && id.matches('.*_' + request.auth.uid) && request.resource.data.log.size() <= 260;
    }
    // tek belgelik bekleme odasi: "Rakip bul"a basan ilk kisi bekler, ikinci gelen eslesir
    match /ab_lobby/{id} {
      allow read, write: if request.auth != null;
    }
    // oyuncu profili (isim, rutbe puani, gunluk gorevler): herkes okur, sadece sahibi yazar; puan bir seferde en fazla 1000 artar
    match /ab_players/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 14
        && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp <= 3000
        && abLook(request.resource.data) && (!('gold' in request.resource.data) || request.resource.data.gold <= 2000);
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 14
        && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp <= resource.data.xp + 1000
        && abLook(request.resource.data)
        && (!('gold' in request.resource.data) || request.resource.data.gold <= ('gold' in resource.data ? resource.data.gold : 0) + 1000);
    }
    // profil görünümü: slogan, arma, zırh, altın, açılan eşyalar
    function abLook(d) {
      return (!('motto' in d) || (d.motto is string && d.motto.size() <= 40))
        && (!('gold' in d) || (d.gold is int && d.gold >= 0))
        && (!('unl' in d) || (d.unl is list && d.unl.size() <= 20))
        && (!('av' in d) || (d.av is string && d.av.size() <= 12))
        && (!('hull' in d) || (d.hull is string && d.hull.size() <= 12))
        && (!('sea' in d) || (d.sea is string && d.sea.size() <= 12));
    }
    // haftalik siralama: sadece rakibin filosunu batirarak kazanilan online maclar; her mac bir kez sayilir
    match /ab_wins/{gid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && get(/databases/$(database)/documents/ab_games/$(gid)).data.status == 'over'
        && get(/databases/$(database)/documents/ab_games/$(gid)).data.winner == request.auth.uid
        && get(/databases/$(database)/documents/ab_games/$(gid)).data.why == 'sunk';
    }
    match /ab_weekly/{wk}/players/{uid} {
      allow read: if request.auth != null;
      allow create: if winOk(wk, uid) && request.resource.data.wins == 1;
      allow update: if winOk(wk, uid) && request.resource.data.wins == resource.data.wins + 1;
    }
    // haftanin numarasi (pazartesi 00:00 Istanbul) +-1 tolerans; galibiyet ayni yazimda ab_wins'e yeni eklenmis olmali
    function winOk(wk, uid) {
      return request.auth != null && request.auth.uid == uid
        && int(wk) >= (request.time.toMillis() + 10800000 - 345600000) / 604800000 - 1
        && int(wk) <= (request.time.toMillis() + 10800000 - 345600000) / 604800000 + 1
        && request.resource.data.name is string && request.resource.data.name.size() <= 14
        && request.resource.data.lastGid is string
        && !exists(/databases/$(database)/documents/ab_wins/$(request.resource.data.lastGid))
        && existsAfter(/databases/$(database)/documents/ab_wins/$(request.resource.data.lastGid))
        && getAfter(/databases/$(database)/documents/ab_wins/$(request.resource.data.lastGid)).data.uid == uid;
    }
    // arkadasla oyna: 4 haneli oda kodu -> mac belgesi
    match /ab_rooms/{code} {
      allow read, write: if request.auth != null && code.matches('^[0-9]{4}$');
    }
    // mac belgesi: yalnizca iki oyuncu okur/yazar; bos koltuga ikinci oyuncu oturabilir
    match /ab_games/{gid} {
      allow read: if request.auth != null && (resource == null
        || request.auth.uid == resource.data.p1 || request.auth.uid == resource.data.p2 || resource.data.p2 == null);
      allow create: if request.auth != null && (
        (request.resource.data.p1 == request.auth.uid && request.resource.data.p2 == null)
        // rövanş: aynı iki oyuncu için yeni maç, oyunculardan biri açar
        || (request.resource.data.rematchOf is string
            && (request.auth.uid == request.resource.data.p1 || request.auth.uid == request.resource.data.p2)));
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.p1 || request.auth.uid == resource.data.p2
        || (resource.data.p2 == null && request.resource.data.p2 == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['p2','status','names','ranks','looks','hb'])));
      allow delete: if request.auth != null && request.auth.uid == resource.data.p1;
    }

    // Raf Izi (Kitapligim): kitaplik/{lib} = sahibinin uid'si; aile uyeleri kitaplik/{lib}.uyeler listesinde
    function rafUye(lib) {
      return request.auth != null && (request.auth.uid == lib ||
        (exists(/databases/$(database)/documents/kitaplik/$(lib)) &&
         request.auth.uid in get(/databases/$(database)/documents/kitaplik/$(lib)).data.get('uyeler', [])));
    }
    match /kitaplik/{lib} {
      allow read: if rafUye(lib);
      allow write: if request.auth != null && request.auth.uid == lib;
      match /books/{id} { allow read, write: if rafUye(lib); }
      match /meta/{id} { allow read, write: if rafUye(lib); }
      match /photos/{id} { allow read, write: if rafUye(lib); }
      // kisisel okuma / odunc bilgisi: yalnizca o kisi
      match /kisisel/{uid}/{rest=**} { allow read, write: if request.auth != null && request.auth.uid == uid && rafUye(lib); }
    }
    match /kitaplikUye/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /kitaplikDavet/{code} {
      allow read, write: if false;
    }
    // Kitapligim gunluk tanima kotasi: yalnizca sunucu yazar
    match /kitaplikKota/{id} {
      allow read, write: if false;
    }
  }
}
